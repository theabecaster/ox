{
  "name": "oxcode-cli",
  "version": "0.1.0",
  "description": "Ox — the open coding agent. A terminal AI pair-programmer powered by ox-alpha via OpenRouter.",
  "license": "AGPL-3.0-only",
  "author": "Abe <theabecaster0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theabecaster/ox.git"
  },
  "homepage": "https://github.com/theabecaster/ox#readme",
  "bugs": "https://github.com/theabecaster/ox/issues",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "openrouter",
    "terminal",
    "llm",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ox": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "eslint": "^9.17.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
